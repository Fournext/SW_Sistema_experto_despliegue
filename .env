# ==========================================
# Configuración del Despliegue con Docker Compose
# ==========================================

# Puertos expuestos en el Host
FRONT_PORT=3000
BACK_PORT=8000
DB_PORT=5432

# Configuración de Base de Datos PostgreSQL
DB_NAME=sistemas_expertos_db
DB_USER=postgres
DB_PASSWORD=postgres

# Configuración de Backend (Django)
DEBUG=True
SECRET_KEY=django-insecure-sprint1-expert-systems-secret-key-change-in-production
DJANGO_SETTINGS_MODULE=config.settings.development
SEED_DATA=true
MAX_INFERENCE_ITERATIONS=100

# Configuración de Frontend (Vite)
VITE_API_URL=http://localhost:8000/api/v1
